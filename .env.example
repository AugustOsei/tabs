# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=
# Fast, low-cost model for the portfolio idea and the chat assistant.
ANTHROPIC_MODEL=claude-haiku-4-5

# n8n webhooks
N8N_WEBHOOK_REGISTRATION_URL=
N8N_WEBHOOK_PAID_URL=
# Optional. Sent as the X-Webhook-Secret header so n8n can reject other callers.
N8N_WEBHOOK_SECRET=

# Admin (Phase 4)
ADMIN_EMAIL=
